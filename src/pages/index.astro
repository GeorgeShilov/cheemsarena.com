---
import Layout from '@/layouts/Layout.astro'; import LeadDialog from '@/components/LeadDialog.astro';
---
<Layout title="The friendliest battle arena"><div class="lobby"><header><b>CHEEMS<br/>ARENA</b><nav><a href="#modes">Game modes</a><a href="#squad">Squad</a></nav><button data-lead>JOIN WAITLIST</button></header><section class="arena"><div class="burst">SEASON<br/><b>00</b></div><div class="copy"><p>CHAOS IS BETTER WITH FRIENDS</p><h1>Brawl.<br/>Bonk.<br/><i>Become legend.</i></h1><button data-lead>CLAIM YOUR PLAYER TAG →</button></div><img src="/assets/generated/hero-arena.jpg" alt="Colorful friendly multiplayer arena"/><aside><b>8</b><span>PLAYERS</span><b>6m</b><span>MATCHES</span><b>∞</b><span>MEMES</span></aside></section><section id="modes" class="modes"><h2>Pick your chaos.</h2><div><article class="pink"><span>01</span><h3>Bonk Royale</h3><p>Last Cheems standing. No hard feelings.</p></article><article class="yellow"><span>02</span><h3>Snack Run</h3><p>Grab treats, dodge traps, betray nobody.</p></article><article class="blue"><span>03</span><h3>Squad Scramble</h3><p>Four paws, one questionable plan.</p></article></div></section><section id="squad" class="squad"><div><p>BUILT BY PLAYERS WHO LAUGH</p><h2>Small team.<br/>Big bonk energy.</h2><button data-lead>Say gm to the squad</button></div><img src="/assets/generated/arena-team.jpg" alt="Playful game studio team"/></section><LeadDialog /></div></Layout>
<style>:global(.site-header),:global(.site-footer){display:none}.lobby{background:#fff3cf;color:#171526;font-family:Arial,sans-serif}.lobby>header{height:86px;display:flex;align-items:center;justify-content:space-between;padding:0 4vw;border-bottom:3px solid #171526}.lobby>header b{line-height:.8}.lobby nav{display:flex;gap:30px}.lobby button{border:3px solid #171526;background:#ffdb36;padding:13px 20px;border-radius:12px;font-weight:900;box-shadow:5px 5px 0 #171526}.arena{min-height:calc(100vh - 86px);position:relative;overflow:hidden;display:flex;align-items:center;padding:5vw;background:#6de1d3}.arena>img{position:absolute;right:9%;bottom:0;width:52%;height:92%;object-fit:cover;border:3px solid #171526;border-radius:48% 48% 10px 10px}.copy{position:relative;z-index:2}.copy h1{font-size:clamp(4.5rem,10vw,10rem);line-height:.72;letter-spacing:-.08em;margin:.2em 0}.copy i{color:#fb4c8d}.burst{position:absolute;right:4vw;top:3vw;z-index:3;background:#ffdb36;border:3px solid;border-radius:50%;padding:25px;transform:rotate(10deg);text-align:center}.arena aside{position:absolute;z-index:4;right:2vw;bottom:2vw;display:grid;background:#171526;color:white;padding:14px}.arena aside b{font-size:1.6rem;color:#ffdb36}.modes{padding:8vw 4vw}.modes h2{font-size:clamp(3rem,7vw,7rem)}.modes>div{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}.modes article{padding:30px;min-height:320px;border:3px solid;border-radius:24px;box-shadow:9px 9px 0}.modes h3{font-size:2.5rem}.pink{background:#fb77aa}.yellow{background:#ffdb36}.blue{background:#77a7ff}.squad{display:grid;grid-template-columns:1fr 1.2fr;align-items:center;background:#2e2258;color:white}.squad div{padding:6vw}.squad h2{font-size:clamp(3.5rem,6vw,6rem);line-height:.9}.squad img{width:100%;height:650px;object-fit:cover}@media(max-width:760px){.lobby nav{display:none}.arena>img{opacity:.45;width:90%}.arena aside{display:none}.modes>div,.squad{grid-template-columns:1fr}.squad img{height:440px}}</style>
